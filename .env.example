# ============ 数据库 ============
DATABASE_URL=postgresql://allinone:allinone@localhost:5432/allinone

# ============ 外部服务 ============
RSSHUB_URL=http://rsshub:1200
BROWSERLESS_URL=http://browserless:3000
# CRAWL4AI_CDP_URL=ws://browserless:3000/chromium/playwright  # Crawl4AI CDP 连接地址

# ============ 安全 ============
# API_KEY=          # 留空则跳过认证（仅限本地开发）
# CORS_ORIGINS=*    # 生产环境应设为具体域名
# 凭证加密密钥（Fernet），生产环境强烈建议设置
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIAL_ENCRYPTION_KEY=

# ============ 应用 ============
LOG_LEVEL=INFO
# TZ=Asia/Shanghai  # 时区，影响定时任务边界计算

# ============ 文件存储 ============
# DATA_DIR=data
# MEDIA_DIR=data/media
# REPORTS_DIR=data/reports
# LOG_DIR=data/logs

# ============ 代理（可选） ============
# PROXY_URL=http://127.0.0.1:7890  # 代理地址，留空则不走代理

# ============ RSSHub 配置（docker-compose 传递给 rsshub 容器） ============
# BILIBILI_COOKIE=
# YOUTUBE_COOKIE=

# ============ LLM 配置 ============
# LLM 配置已迁移到系统设置页面（数据库 system_settings 表），无需在此配置

# ============ 金融数据（蚂蚁 financial-data，MCP 金融工具主数据源） ============
# 留空则自动降级到 akshare/雪球（功能不受影响，稳定性下降）
# 申请: https://stockai.antgroup-inc.cn/mcp-market?key=doc__api-key
# 注意: 该服务当前面向蚂蚁内部/邀请制用户，公开可用性以官方页面为准
# FINANCIAL_DATA_API_KEY=
# FINANCIAL_DATA_ENABLED=true     # 设为 false 一键回退旧数据源
# FINANCIAL_DATA_TOOLS=all        # 工具级开关: snapshot,quote,kline,macro
# FINANCIAL_DATA_TIMEOUT=8.0
